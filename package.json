{
  "name": "ales-pratik",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Geçmiş ALES sorularıyla çalışmak için tarayıcıda çalışan, Türkçe arayüzlü soru pratiği uygulaması.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 4173",
    "deploy": "npm run build && firebase deploy --only hosting",
    "validate": "node scripts/validate-questions.mjs",
    "check": "tsc --noEmit && npm run validate && npm run check:tex",
    "check:tex": "node scripts/check-tex.mjs",
    "math": "node scripts/convert-math.mjs"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
